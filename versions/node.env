# Single source of truth for the Node 22 toolchain pinned by DOCKER-CONVENTIONS.md.
#
# ci/Dockerfile and e2e/Dockerfile each download and verify their own Node 22
# tarball -- neither of their base images ships Node, or ships the version
# this repo pins -- but both must agree on exactly which build. Both source
# this file at build time instead of hardcoding the version and checksums, so
# there is one place to bump on a Node version change.
NODE_VERSION=22.23.2
NODE_SHA256_AMD64=d60acfe00a2932254bb0ad20e01b0d74397a0875595de719654b214f4b03f307
NODE_SHA256_ARM64=fff4078c5def658577f92c88db7db3bc0072924bfb93fe52c1e744a54e94abb8
