{
  "name": "fullstack-loop-frontend",
  "version": "1.0.0",
  "description": "Angular consumer of the Fullstack Loop Task API, generated from openapi/openapi.yaml.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:api": "docker run --rm -v \"$PWD/..:/local\" -u $(id -u):$(id -g) openapitools/openapi-generator-cli:v7.16.0 generate -i /local/openapi/openapi.yaml -g typescript-angular -o /local/frontend/src/app/api/generated --additional-properties=ngVersion=20.0.0,providedInRoot=true,fileNaming=kebab-case,withInterfaces=true,useSingleRequestParameter=false",
    "start": "ng serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts --coverage",
    "test:component": "vitest run --config vitest.component.config.ts --coverage",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:pact": "vitest run --config vitest.pact.config.ts",
    "test:mutation": "stryker run",
    "mutation": "npm run test:mutation",
    "build": "./scripts/ng-build-strict.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:component && npm run test && npm run test:mutation && npm run build"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.39.5",
    "@pact-foundation/pact": "^15.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/angular": "^18.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "angular-eslint": "^20.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.4"
  }
}
