{
  "consumer": {
    "name": "fullstack-loop-frontend"
  },
  "interactions": [
    {
      "description": "an authenticated request for a missing task",
      "providerStates": [
        {
          "name": "no task with id 000000000000000000000000 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer eyJhbGciOiJSUzI1NiJ9.eyJpc3MiOiJodHRwczovL2F1dGguZnVsbHN0YWNrLWxvb3AubG9jYWwvIiwiYXVkIjoiZnVsbHN0YWNrLWxvb3AtYXBpIn0.bm90LWEtc2lnbmF0dXJl"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/tasks/000000000000000000000000"
      },
      "response": {
        "body": {
          "status": 404,
          "title": "Task not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "an authenticated request for all tasks",
      "providerStates": [
        {
          "name": "two tasks exist"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer eyJhbGciOiJSUzI1NiJ9.eyJpc3MiOiJodHRwczovL2F1dGguZnVsbHN0YWNrLWxvb3AubG9jYWwvIiwiYXVkIjoiZnVsbHN0YWNrLWxvb3AtYXBpIn0.bm90LWEtc2lnbmF0dXJl"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/tasks"
      },
      "response": {
        "body": [
          {
            "completed": false,
            "id": "65f1c2d4e8a9b01234567890",
            "title": "Write the failing acceptance scenario"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].completed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an authenticated request for that task",
      "providerStates": [
        {
          "name": "a task with id 65f1c2d4e8a9b01234567890 exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer eyJhbGciOiJSUzI1NiJ9.eyJpc3MiOiJodHRwczovL2F1dGguZnVsbHN0YWNrLWxvb3AubG9jYWwvIiwiYXVkIjoiZnVsbHN0YWNrLWxvb3AtYXBpIn0.bm90LWEtc2lnbmF0dXJl"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer [A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/tasks/65f1c2d4e8a9b01234567890"
      },
      "response": {
        "body": {
          "completed": false,
          "id": "65f1c2d4e8a9b01234567890",
          "title": "Write the failing acceptance scenario"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.completed": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an unauthenticated request for all tasks",
      "providerStates": [
        {
          "name": "the caller is unauthenticated"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/tasks"
      },
      "response": {
        "body": {
          "status": 401,
          "title": "Unauthorized"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "15.0.1"
    },
    "pactRust": {
      "ffi": "0.4.28",
      "models": "1.3.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "fullstack-loop-backend"
  }
}